{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:immortal-aep:schema:local-operator-consent-claims:0.1.0",
  "title": "IMMORTAL Local Operator Consent Claims",
  "description": "Proposed signed record of one explicit local operator decision over an exact task/grant intent. Semantic validation MUST compare confirmedChallenge to displayedChallenge, bind every duplicated field to the grant intent, and verify the trusted interactive consent broker; schema validity alone never proves human consent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "consentId",
    "issuerId",
    "operatorPrincipalId",
    "consentBrokerId",
    "grantId",
    "consentIntentDigest",
    "taskId",
    "manifestDigest",
    "hostPolicyDigest",
    "capability",
    "workspaceRef",
    "scopeDigest",
    "decision",
    "interactionMode",
    "interactionId",
    "displayedChallenge",
    "confirmedChallenge",
    "issuedAt",
    "expiresAt",
    "nonce",
    "sequence"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "consentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "issuerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operatorPrincipalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Stable principal identifier resolved by the trusted local consent broker, not supplied by task or model text."
    },
    "consentBrokerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "grantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "consentIntentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "hostPolicyDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "capability": {
      "type": "string",
      "enum": [
        "workspace.list",
        "workspace.read",
        "workspace.diff",
        "workspace.verify",
        "workspace.create",
        "workspace.replace",
        "workspace.test"
      ]
    },
    "workspaceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "deny"
      ]
    },
    "interactionMode": {
      "type": "string",
      "const": "local-interactive-digest-confirmation"
    },
    "interactionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "displayedChallenge": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}$",
      "description": "Eight lowercase hexadecimal characters derived from the consentIntentDigest and shown by the trusted local UI."
    },
    "confirmedChallenge": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}$",
      "description": "Must equal displayedChallenge exactly; semantic validation rejects any mismatch."
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
