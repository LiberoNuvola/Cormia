{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:immortal-aep:schema:local-revocation-checkpoint-claims:0.1.0",
  "title": "IMMORTAL Local Revocation Checkpoint Claims",
  "description": "Signed statement of the latest validated revocation journal head. The same sequence and digest must be independently pinned by a protected monotonic anchor provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "issuerId",
    "anchorProviderId",
    "sequence",
    "headEventDigest",
    "issuedAt",
    "checkpointId"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "issuerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "anchorProviderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headEventDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checkpointId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sequence": {
            "const": 0
          }
        },
        "required": [
          "sequence"
        ]
      },
      "then": {
        "properties": {
          "headEventDigest": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sequence": {
            "minimum": 1
          }
        },
        "required": [
          "sequence"
        ]
      },
      "then": {
        "properties": {
          "headEventDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
