{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:immortal-aep:schema:local-host-authority-key-descriptor:0.1.0",
  "title": "IMMORTAL Local Host Authority Key Descriptor",
  "description": "Local metadata for a host signing key. Contains only public key material and an opaque provider handle; private key bytes are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "issuerId",
    "keyId",
    "algorithm",
    "publicKeySpkiDerBase64",
    "publicKeySha256",
    "providerId",
    "providerKeyRef",
    "privateKeyExportable",
    "generation",
    "status",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "issuerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "algorithm": {
      "type": "string",
      "const": "Ed25519"
    },
    "publicKeySpkiDerBase64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 40,
      "maxLength": 512
    },
    "publicKeySha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "providerId": {
      "type": "string",
      "enum": [
        "os-keystore",
        "hardware-backed-provider",
        "operator-managed-provider"
      ]
    },
    "providerKeyRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "privateKeyExportable": {
      "type": "boolean",
      "const": false
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending-pin",
        "active",
        "retired",
        "revoked"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "notBefore": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "previousKeyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trustAnchorFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
