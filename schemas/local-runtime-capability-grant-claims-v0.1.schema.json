{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:immortal-aep:schema:local-runtime-capability-grant-claims:0.1.0",
  "title": "IMMORTAL Local Runtime Capability Grant Claims",
  "description": "Non-normative local grant claims carried as the payload of a compact JWS. This is not the Task Manifest or a network authorization format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "grantId",
    "taskId",
    "manifestDigest",
    "issuerId",
    "subject",
    "capability",
    "scope",
    "issuedAt",
    "notBefore",
    "expiresAt",
    "delegable"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "grantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "issuerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerId",
        "runtimeId"
      ],
      "properties": {
        "workerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runtimeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "capability": {
      "type": "string",
      "enum": [
        "workspace.list",
        "workspace.read",
        "workspace.diff",
        "workspace.verify",
        "workspace.create",
        "workspace.replace",
        "workspace.test"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRef"
      ],
      "properties": {
        "workspaceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "directories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "executionProfileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "notBefore": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "delegable": {
      "type": "boolean",
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capability": {
            "const": "workspace.list"
          }
        },
        "required": [
          "capability"
        ]
      },
      "then": {
        "properties": {
          "scope": {
            "required": [
              "directories"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "files"
                  ]
                },
                {
                  "required": [
                    "executionProfileId"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capability": {
            "const": "workspace.test"
          }
        },
        "required": [
          "capability"
        ]
      },
      "then": {
        "properties": {
          "scope": {
            "required": [
              "executionProfileId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "files"
                  ]
                },
                {
                  "required": [
                    "directories"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capability": {
            "enum": [
              "workspace.read",
              "workspace.diff",
              "workspace.verify",
              "workspace.create",
              "workspace.replace"
            ]
          }
        },
        "required": [
          "capability"
        ]
      },
      "then": {
        "properties": {
          "scope": {
            "required": [
              "files"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "directories"
                  ]
                },
                {
                  "required": [
                    "executionProfileId"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
