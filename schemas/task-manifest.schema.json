{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:immortal:aep:task-manifest:v0.1.0",
  "title": "IMMORTAL-AEP Task Manifest",
  "description": "Draft schema. Not yet a finalized canonical encoding or signing envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "manifestSchemaVersion", "requesterId", "taskClass", "scope", "acceptanceCriteria", "inputCommitments", "deliverableSchema", "capabilitySet", "budget", "assuranceProfile", "deadline", "privacyClass", "failurePolicy", "disputePolicy", "evidenceFormat"],
  "properties": {
    "protocolVersion": { "type": "string", "minLength": 1 },
    "manifestSchemaVersion": { "type": "string", "const": "0.1.0" },
    "taskId": { "type": "string", "minLength": 1 },
    "requesterId": { "type": "string", "minLength": 1 },
    "taskClass": { "type": "string", "enum": ["software", "data", "compute", "research", "other-digital"] },
    "scope": { "type": "object", "additionalProperties": false, "required": ["objective", "included", "excluded"], "properties": { "objective": { "type": "string", "minLength": 1 }, "included": { "type": "array", "items": { "type": "string" } }, "excluded": { "type": "array", "items": { "type": "string" } } } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["criterionId", "kind", "statement", "required"], "properties": { "criterionId": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["test", "build", "hash-match", "schema-validation", "proof-verification", "external-attestation"] }, "statement": { "type": "string", "minLength": 1 }, "verifierReference": { "type": "string" }, "required": { "type": "boolean" } } } },
    "inputCommitments": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["digest", "digestAlgorithm"], "properties": { "uri": { "type": "string" }, "digest": { "type": "string", "minLength": 1 }, "digestAlgorithm": { "type": "string", "minLength": 1 }, "mediaType": { "type": "string" }, "privacyClass": { "type": "string" } } } },
    "deliverableSchema": { "type": "object", "additionalProperties": false, "required": ["description", "requiredArtifacts"], "properties": { "description": { "type": "string" }, "requiredArtifacts": { "type": "array", "items": { "type": "string" } } } },
    "capabilitySet": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["capability", "scope"], "properties": { "capability": { "type": "string", "minLength": 1 }, "scope": { "type": "object" }, "constraints": { "type": "object" }, "delegable": { "type": "boolean", "default": false } } } },
    "budget": { "type": "object", "additionalProperties": false, "required": ["assetId", "maxAmount", "refundAddress"], "properties": { "assetId": { "type": "string", "minLength": 1 }, "maxAmount": { "type": "string", "pattern": "^[0-9]+$" }, "refundAddress": { "type": "string", "minLength": 1 }, "protocolFee": { "type": "string", "pattern": "^[0-9]+$" }, "milestones": { "type": "array", "items": { "type": "object" } } } },
    "workerBondProfile": { "type": "string" },
    "verifierBondProfile": { "type": "string" },
    "assuranceProfile": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4", "S"] },
    "verifierSelectionProfile": { "type": "string" },
    "deadline": { "type": "string", "format": "date-time" },
    "submissionWindow": { "type": "string" },
    "challengeWindow": { "type": "string" },
    "resourceProfile": { "type": "object", "description": "Declared requirements only; worker-reported telemetry is not authoritative proof.", "properties": { "cpu": { "type": "object" }, "memory": { "type": "object" }, "gpu": { "type": "object" }, "maxWallTimeSeconds": { "type": "integer", "minimum": 1 } } },
    "privacyClass": { "type": "string", "enum": ["public", "committed-private", "confidential"] },
    "retentionPolicy": { "type": "string" },
    "failurePolicy": { "type": "string", "minLength": 1 },
    "cancellationPolicy": { "type": "string" },
    "disputePolicy": { "type": "string", "minLength": 1 },
    "evidenceFormat": { "type": "string", "minLength": 1 },
    "runtimeImageDigest": { "type": "string" },
    "toolchainCommitments": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  }
}
