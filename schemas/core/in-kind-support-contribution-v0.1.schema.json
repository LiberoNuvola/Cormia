{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cormia:core:in-kind-support-contribution:0.1.0",
  "title": "Cormia Optional In-Kind Support Contribution",
  "description": "Optional in-kind contribution record. It references an independently validated Resource Offer where applicable and has no money-equivalent field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "contributionId",
    "contributionKind",
    "inKindType",
    "targetKind",
    "targetRef",
    "contributorRef",
    "beneficiaryKind",
    "beneficiaryRef",
    "scopeRef",
    "status",
    "recordedAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "recordType": {
      "type": "string",
      "const": "cormia.core.in-kind-support-contribution"
    },
    "contributionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "contributionKind": {
      "type": "string",
      "const": "in_kind"
    },
    "inKindType": {
      "type": "string",
      "enum": [
        "compute",
        "infrastructure",
        "data",
        "expertise",
        "review",
        "volunteer_work"
      ]
    },
    "targetKind": {
      "type": "string",
      "enum": [
        "project",
        "workstream",
        "milestone",
        "resource_pool"
      ]
    },
    "targetRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "contributorRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "beneficiaryKind": {
      "type": "string",
      "enum": [
        "project",
        "named_custodian",
        "resource_pool"
      ]
    },
    "beneficiaryRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scopeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "resourceOfferRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "artifactOrServiceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "providerConstraintsRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "privacyProfileRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "type": "string",
      "enum": [
        "offered",
        "accepted",
        "active",
        "completed",
        "revoked",
        "rejected"
      ]
    },
    "acceptanceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "inKindType": {
            "enum": [
              "compute",
              "infrastructure"
            ]
          }
        },
        "required": [
          "inKindType"
        ]
      },
      "then": {
        "required": [
          "resourceOfferRef"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "active",
              "completed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "acceptanceRef"
        ]
      }
    }
  ]
}
