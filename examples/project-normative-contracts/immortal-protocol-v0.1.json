      },
      {
        "triggerId": "human.resource-expansion",
        "category": "resource-budget-expansion",
        "description": "Increasing the approved compute, memory, concurrency, attempt or execution-time budget.",
        "requiresHumanAuthority": true,
        "defaultAction": "prepare-options-and-escalate",
        "escalationScope": "affected-task"
      },
      {
        "triggerId": "human.source-baseline-adoption",
        "category": "source-baseline-adoption",
