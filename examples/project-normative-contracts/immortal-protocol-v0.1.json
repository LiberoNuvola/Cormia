        "defaultAction": "prepare-options-and-escalate",
        "escalationScope": "project-wide"
      }
    ]
  },
  "executionPolicy": {
    "autonomousActivities": [
      "specification-implementation",
      "bug-fix",
      "refactor",
      "test-authoring",
      "build-and-test",
      "simulation",
      "evidence-collection",
      "evidence-classification",
      "feature-branch-commit",
      "draft-normative-change-proposal"
    ],
    "forbiddenSemanticActions": [
      "weaken-invariant",
      "narrow-authoritative-uncertainty-envelope",
      "change-closed-economic-parameter",
      "reopen-closed-decision",
      "suppress-failed-evidence",
      "promote-evidence-class",
      "invent-missing-normative-rule",
      "self-approve-normative-change",
      "change-trust-root"
    ],
    "humanApprovalPerOperation": false,
    "continueIndependentTasksOnBlock": true,
    "codeMayImplementExistingNormativeRules": true,
    "normativeSourceEditsRequireHumanAuthority": true,
    "evidencePromotionByModelAllowed": false,
    "stopOnSourceIntegrityFailure": true
  },
  "conflictPolicy": {
    "higherAuthorityPrevails": true,
    "unresolvedSameClassConflict": "escalate",
    "evidenceCreatesNormativeAuthority": false,
    "statusRecordCanWaiveObligation": false,
    "floatingSourceRefsAllowed": false
  }
