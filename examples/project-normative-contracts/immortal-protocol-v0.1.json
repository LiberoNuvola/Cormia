        "requiresHumanAuthority": true,
        "defaultAction": "prepare-options-and-escalate",
        "escalationScope": "dependent-subgraph"
      },
      {
        "triggerId": "human.source-conflict",
        "category": "material-source-conflict",
        "description": "Two authoritative sources conflict and no explicit precedence or supersession rule resolves the conflict.",
