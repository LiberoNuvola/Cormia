  "closedDecisions": [
    {
      "decisionId": "prerich.class-ladder-and-bootstrap",
      "title": "PRE-RICH class ladder and Genesis baseline",
      "scope": "application:pre-rich",
      "statement": "KA=8, KC=4, KD=4; ticket ladder 1/2/3/5/10/25/50/100 USDM; Genesis ticket 1 USDM; verified PRE Treasury bootstrap >=4000 USDM; maximum normal payout 500×P. These are application-level frozen semantics, not universal IMMORTAL constants.",
      "sourceRefs": [
        "prerich.game-economy"
      ],
      "status": "closed",
      "reopenRequiresHumanAuthority": true,
      "parameterBoundary": "application-constant"
    },
    {
      "decisionId": "prerich.classic6-two-row-model",
      "title": "Canonical Classic-6 two-row model",
      "scope": "application:pre-rich",
      "statement": "Classic-6 has two independent rows over a uniform 20,000-slot domain; ticket payout is the sum of row payouts, capped at 500×P. Implementation must conform to this closed model.",
      "sourceRefs": [
        "prerich.game-economy"
      ],
      "status": "closed",
      "reopenRequiresHumanAuthority": true,
      "parameterBoundary": "application-constant"
    },
    {
      "decisionId": "prerich.jackpot-policy",
      "title": "Jackpot activation, funding and payout semantics",
      "scope": "application:pre-rich",
      "statement": "Jackpot activation/funding is state-derived and deterministic; payout is the full current locked balance exactly once; there is no fixed canonical allocation percentage.",
      "sourceRefs": [
        "prerich.game-economy"
      ],
      "status": "closed",
      "reopenRequiresHumanAuthority": true,
      "parameterBoundary": "application-constant"
    },
    {
      "decisionId": "prerich.expiry-mechanism",
      "title": "Ticket expiry mechanism",
      "scope": "application:pre-rich",
      "statement": "Expiry is state-derived and crystallized at issuance. The exact numeric lifetime remains an application/deployment parameter and is not a universal IMMORTAL constant.",
      "sourceRefs": [
        "prerich.game-economy"
      ],
      "status": "closed",
      "reopenRequiresHumanAuthority": true,
      "parameterBoundary": "mechanism-closed-value-open"
    }
  ],
  "invariants": [
    {
      "invariantId": "immortal.no-discretionary-economic-authority",
      "statement": "No founder, developer, administrator, operator, relayer, publisher, adapter or frontend obtains discretionary economic authority merely by operating infrastructure.",
      "sourceRefs": [
        "immortal.constitution"
      ],
      "protection": "must-not-bypass",
      "enforcement": [
        "static-policy-check",
        "conformance-test",
        "human-review-gate"
      ]
    },
    {
      "invariantId": "immortal.obligations-before-execution",
      "statement": "Accepted obligations and economically material unresolved exposure must be represented before the action creating or accepting them becomes executable.",
      "sourceRefs": [
        "immortal.constitution"
      ],
      "protection": "must-preserve",
      "enforcement": [
        "runtime-guard",
        "conformance-test"
      ]
    },
    {
      "invariantId": "immortal.protected-capital",
      "statement": "Protected capital cannot become discretionary surplus merely because current liquidity is positive; RawSurplus=max(0, EEV−ProtectedCapital).",
      "sourceRefs": [
        "immortal.constitution",
        "immortal.economic-kernel"
      ],
      "protection": "must-not-weaken",
      "enforcement": [
        "runtime-guard",
        "conformance-test",
        "human-review-gate"
      ]
    },
    {
      "invariantId": "immortal.certified-concrete-kernel",
      "statement": "Economic execution is gated on a declared certified concrete kernel K_c; implementation must not claim runtime membership in an uncomputed K*.",
      "sourceRefs": [
        "immortal.constitution",
        "immortal.economic-kernel",
        "immortal.conformance"
      ],
      "protection": "must-preserve",
      "enforcement": [
        "runtime-guard",
        "conformance-test",
        "evidence-classifier"
      ]
    },
    {
      "invariantId": "immortal.omega-no-narrowing",
      "statement": "The authoritative uncertainty envelope Ω cannot be narrowed by an actor, caller, adapter or operator; enlargement is conservative, narrowing is unsound.",
      "sourceRefs": [
        "immortal.constitution",
        "immortal.economic-kernel",
        "immortal.state-transitions"
      ],
      "protection": "must-not-weaken",
      "enforcement": [
        "static-policy-check",
        "conformance-test",
        "human-review-gate"
      ]
    },
    {
      "invariantId": "immortal.atomic-transitions",
      "statement": "Canonical coupled economic deltas commit atomically or not at all.",
      "sourceRefs": [
        "immortal.constitution",
        "immortal.state-transitions",
        "immortal.conformance"
      ],
      "protection": "must-preserve",
      "enforcement": [
        "runtime-guard",
        "conformance-test"
      ]
    },
    {
      "invariantId": "immortal.expiry-finality",
      "statement": "Expiry cannot be reversed and late reveal cannot restore claimability or create a new liability.",
      "sourceRefs": [
        "immortal.constitution",
        "immortal.state-transitions",
        "prerich.game-economy"
      ],
      "protection": "must-not-bypass",
      "enforcement": [
        "conformance-test",
        "human-review-gate"
      ]
    },
    {
      "invariantId": "immortal.evidence-non-promotion",
      "statement": "Mechanical evidence is not a mathematical proof, and implementation conformance evidence is not a theorem about the abstract model or normative authority.",
      "sourceRefs": [
        "immortal.conformance",
        "immortal.formal-proof-register",
        "immortal.verification-status"
      ],
      "protection": "must-not-promote-evidence",
      "enforcement": [
        "evidence-classifier",
        "static-policy-check"
      ]
    }
  ],
