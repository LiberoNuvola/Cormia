        "requiresHumanAuthority": true,
        "defaultAction": "quarantine-on-trust-failure",
        "escalationScope": "project-wide"
      },
      {
        "triggerId": "human.governance-authority",
        "category": "governance-authority-change",
        "description": "Changing governance authority or accepting an upgrade/migration decision that requires governance execution.",
        "requiresHumanAuthority": true,
        "defaultAction": "prepare-options-and-escalate",
